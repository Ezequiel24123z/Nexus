{
  "name": "nexus-desktop",
  "version": "1.5.0",
  "description": "NEXUS Autonomous Standalone Agentic Coding, Private Browser & Personal Operator Workstation (Native Windows WebView2, Zero Electron)",
  "author": "NEXUS",
  "repository": "https://github.com/Ezequiel24123z/Nexus",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "vite build",
    "build:native": "dotnet build native-host/NEXUS.csproj -c Release -o release/NEXUS --nologo",
    "build": "npm run build:ui && npm run build:native",
    "dist:portable": "npm run build && node tools/build-portable.mjs",
    "start": "node tools/launch.mjs",
    "start:web": "node core/server.mjs --standalone --open",
    "start:headless": "node core/server.mjs --standalone",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "eventsource-parser": "4.1.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.31.0",
    "mermaid": "^12.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "vite": "8.3.0"
  }
}
